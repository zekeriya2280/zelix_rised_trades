{
  // ==================== AI CODE COMPLETION SETTINGS ====================
  // GitHub Copilot (En iyi seçenek - ama ücretli)
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": false,
    "markdown": true,
    "dart": true
  },
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.advanced": {
    "debug.overrideEngine": "gpt-4",
    "debug.testOverrideProxyUrl": "",
    "debug.overrideProxyUrl": ""
  },
  // Tabnine (Ücretsiz + Premium seçenekleri)
  "tabnine.experimentalAutoImports": true,
  // IntelliCode (Microsoft - Ücretsiz)
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "vsintellicode.features.python.deepLearning": "enabled",
  // ==================== DART/FLUTTER SETTINGS ====================
  // Auto-complete ve IntelliSense
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.tabCompletion": "on",
  "editor.wordBasedSuggestions": "matchingDocuments",
  // Dart formatter ve linter
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [
      80
    ],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.defaultFormatter": "Dart-Code.dart-code"
  },
  // Flutter hot reload on save
  "dart.flutterHotReloadOnSave": "always",
  "dart.flutterHotRestartOnSave": "never",
  // Dart analysis
  "dart.analysisExcludedFolders": [
    ".dart_tool",
    "build",
    ".pub-cache"
  ],
  "dart.previewLsp": true,
  "dart.enableSnippets": true,
  "dart.completeFunctionCalls": true,
  // Import organization
  "dart.organizeDirectivesOnSave": true,
  "dart.lineLength": 80,
  // Widget guides
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,
  // Code folding
  "editor.foldingImportsByDefault": true,
  "editor.showFoldingControls": "always",
  // Bracket pair colorization
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  // IntelliSense
  "editor.suggest.localityBonus": true,
  "editor.suggestFontSize": 14,
  "editor.suggestLineHeight": 24,
  // Auto import
  "dart.autoImportCompletions": true,
  // Widget wrapping
  "dart.previewBazelWorkspaceCustomScripts": true,
  // Error highlighting
  "dart.showTodos": true,
  "dart.allowAnalytics": false,
  // Files
  "files.exclude": {
    "**/.dart_tool": true,
    "**/.flutter-plugins": true,
    "**/.flutter-plugins-dependencies": true,
    "**/.packages": true,
    "**/pubspec.lock": false
  },
  // Search
  "search.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/.pub-cache": true
  },
  // Terminal
  "terminal.integrated.env.windows": {
    "FLUTTER_ROOT": "${env:FLUTTER_ROOT}"
  },
  // Emmet for Flutter
  "emmet.includeLanguages": {
    "dart": "html"
  },
  // Prettier/formatting
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  // Code lens
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  // Test explorer
  "dart.flutterTestAdditionalArgs": [
    "--no-sound-null-safety"
  ],
  // Additional useful settings
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  // Git
  "git.ignoreLimitWarning": true
}
